@ One object serves as the delegate of the application, of the window and of the view.
Its instance variables are the application of the first part, the window, the view and
the time of the previous frame.

<<The delegate of the application>>=
// A metal-cpp pointer and an Objective-C reference name the same object: converting one
// into the other is a cast.
@interface AppDelegate : NSObject <NSApplicationDelegate, NSWindowDelegate, MTKViewDelegate>
@end

@implementation AppDelegate {
    App* _app;
    NSWindow* _window;
    MTKView* _view;
    std::chrono::steady_clock::time_point _last;
}

