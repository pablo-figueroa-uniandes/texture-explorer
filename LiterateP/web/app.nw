        ImGui::Image(Tex(m.maps[MapColor]->srvLinear.Get()), ImVec2(36, 36));
    else
        ImGui::Dummy(ImVec2(36, 36));
    ImGui::SameLine();
    ImGui::BeginGroup();
    ImGui::TextUnformatted(m.name.c_str());
    ImGui::TextDisabled("%s", m.site.c_str());
    ImGui::EndGroup();
    ImGui::PopID();
}

