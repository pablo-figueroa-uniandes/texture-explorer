constexpr float kPi = 3.14159265f;

@ Dear ImGui refers to textures by an opaque number; with the Direct3D~11 back end, that
number is the address of a shader resource view.

<<Private helpers of the application>>=
ImTextureID Tex(ID3D11ShaderResourceView* srv) { return (ImTextureID)(intptr_t)srv; }

@ The program needs its \texttt{shaders} and \texttt{assets} folders. It looks for them in
the folder of the executable and in its ancestors, which covers both a build tree
(\texttt{build/Release/}) and a copied installation; as a last resort it uses the source
folder recorded by CMake at compile time.

<<Private helpers of the application>>=
std::filesystem::path FindRoot() {
    wchar_t buf[MAX_PATH];
    GetModuleFileNameW(nullptr, buf, MAX_PATH);
    for (auto p = std::filesystem::path(buf).parent_path(); p.has_relative_path(); p = p.parent_path())
        if (std::filesystem::exists(p / "shaders" / "pbr.hlsl")) return p;
    return std::filesystem::path(TEXEX_ROOT);
}

@ Rows of the inspector's tables. A vector is shown with its three components and, when
it is a unit vector, a swatch of the colour that encodes it by $\frac12\vect n+\frac12$
(\S\ref{encoding}). Hovering the label explains the row.

<<Private helpers of the application>>=
ImVec4 Encode(const XMFLOAT3& n) { return {n.x * 0.5f + 0.5f, n.y * 0.5f + 0.5f, n.z * 0.5f + 0.5f, 1}; }

@
<<Private helpers of the application>>=
void Vec3Row(const char* label, const XMFLOAT3& v, bool swatch, const char* tip) {
    ImGui::TableNextRow();
    ImGui::TableNextColumn();
    ImGui::TextUnformatted(label);
    if (tip && ImGui::IsItemHovered()) ImGui::SetTooltip("%s", tip);
    ImGui::TableNextColumn();
    ImGui::Text("(%+.3f, %+.3f, %+.3f)", v.x, v.y, v.z);
    ImGui::TableNextColumn();
    if (swatch) {
        ImGui::PushID(label);
        ImGui::ColorButton("##sw", Encode(v), ImGuiColorEditFlags_NoTooltip, ImVec2(36, 0));
        ImGui::PopID();
    }
}

