@ Each entry is a selectable row as tall as a thumbnail, over which the thumbnail and the
two lines of text are drawn. Clicking a row selects the material (and loads it, should
it not be loaded yet).

<<List the materials with their thumbnails>>=
auto& items = library_.Items();
for (int i = 0; i < int(items.size()); ++i) {
    ImGui::PushID(i);
    const Material& m = items[i];
    if (ImGui::Selectable("##sel", current_ == i, 0, ImVec2(0, 36))) {
        current_ = i;
        library_.EnsureLoaded(i, renderer_.Device(), renderer_.Context());
    }
    ImGui::SameLine(0, 0);
    ImGui::SetCursorPosX(ImGui::GetStyle().WindowPadding.x);
