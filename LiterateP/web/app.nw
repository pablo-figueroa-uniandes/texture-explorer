@ First the plain values: the coordinates in normalized texture space and in texels, and
the value of each map.

<<Show the values of the maps at the probe>>=
ImGui::Text("Probe %s", pinned_ ? "(pinned - right-click a map to release)" : "(hover)");
if (ImGui::BeginTable("vals", 3, ImGuiTableFlags_SizingFixedFit | ImGuiTableFlags_RowBg)) {
    ImGui::TableNextRow();
