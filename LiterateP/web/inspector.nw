#include "Inspector.h"

using namespace DirectX;

<<The normal of a height field>>

<<Inspect one texel>>

@ \label{bumpnormal}\emph{The normal of a height field.} Imagine that, in the
neighbourhood of a point, the surface is the flat plane of tangent space, measured in
texels, and that the bump map lifts it to the height $z=k\,h(x,y)$, where $k$ is the
\emph{bump strength}. The lifted surface has the two tangent vectors
\[ \vect t_x = (1,\,0,\,k\,h_x),\qquad \vect t_y = (0,\,1,\,k\,h_y), \]
where $h_x$ and $h_y$ are the partial derivatives of $h$. The vector
\[ \vect n_{ts} \propto (-k\,h_x,\,-k\,h_y,\,1) \]
is perpendicular to both, as one checks at once:
$\vect n_{ts}\cdot\vect t_x = -k h_x + k h_x = 0$, and likewise for $\vect t_y$. (We avoid
saying ``the cross product of $\vect t_x$ and $\vect t_y$'', because our tangent frame is
left-handed---recall $\vect T\times\vect B=-\vect N$---and the orthogonality argument does
not care about handedness.) Where the map is flat, $h_x=h_y=0$ and $\vect n_{ts}=(0,0,1)$:
the unperturbed normal.

The derivatives are estimated by \emph{central differences} one texel to each side,
\[ h_x \approx \tfrac12\bigl(h(x+1,y)-h(x-1,y)\bigr),\qquad
   h_y \approx \tfrac12\bigl(h(x,y+1)-h(x,y-1)\bigr), \]
which is exact for quadratic functions and, unlike a one-sided difference, does not
shift the normal by half a texel. The samples are bilinear, so the result varies
smoothly between texels. The pixel shader evaluates exactly the same expression
(see <<The normal of a height field, on the GPU>>).

<<The normal of a height field>>=
XMFLOAT3 BumpNormalTangent(const MapImage& bump, float u, float v, float strength, XMFLOAT2* slopeOut) {
    <<Estimate the slope of the height field by central differences>>
    // The surface z = k*h(x,y) has normal (-k*dh/dx, -k*dh/dy, 1).
    XMFLOAT3 n;
    XMStoreFloat3(&n, XMVector3Normalize(XMVectorSet(-strength * dhdx, -strength * dhdy, 1, 0)));
    return n;
}

@ The step to the neighbouring texel is one texel in texture coordinates, $1/W$
horizontally and $1/H$ vertically.

<<Estimate the slope of the height field by central differences>>=
const float du = 1.0f / bump.width, dv = 1.0f / bump.height;
// Height change per texel, by central differences.
const float dhdx = 0.5f * (bump.Sample(u + du, v).x - bump.Sample(u - du, v).x);
const float dhdy = 0.5f * (bump.Sample(u, v + dv).x - bump.Sample(u, v - dv).x);
if (slopeOut) *slopeOut = {dhdx, dhdy};

