@ The ``Inspector'' panel. The only line that differs is the decoding of the pack's
normal map, $\vect n = 2\vect c - 1$, which \texttt{simd} writes as one vector expression.

<<Functions of the application (macOS)>>=
void App::UiInspector() {
    ImGui::Begin("Inspector");
    const Material& m = Current();
    <<Choose the map to inspect>>
    <<Show the inspected map, beside or above the readouts>>

    const HoverInfo& h = info_;
    if (!h.valid) {
        ImGui::TextDisabled("Move the mouse over a map\nto inspect it.");
    } else {
        <<Show the values of the maps at the probe>>

        ImGui::SeparatorText("Normal computed from the bump map");
        ImGui::Text("slope dh/dx = %+.4f, dh/dy = %+.4f  (per texel)", h.slope.x, h.slope.y);
        ImGui::TextDisabled("n_ts = normalize(-k*dh/dx, -k*dh/dy, 1),  k = %.1f", bump_.strength);
        if (ImGui::BeginTable("normals", 3, ImGuiTableFlags_SizingFixedFit | ImGuiTableFlags_RowBg)) {
            Vec3Row("Tangent space n_ts", h.normalTangent, true,
                    "Relative to the surface: x along T (+u), y along B (+v), z along N.\nSwatch = n*0.5+0.5.");
            if (m.maps[MapNormal]) {
                const simd::float4 t = m.maps[MapNormal]->Sample(h.uv.x, h.uv.y);
                const float3 pn = simd::normalize(t.xyz * 2 - 1);
                Vec3Row("Pack normal map", pn, true,
                        "Decoded from the material's own (DirectX convention) normal map, for comparison.\n"
                        "It was baked with a different strength, so only the direction trend matches.");
            }
            if (h.onSurface) {
                Vec3Row("World n' (bumped)", h.normalBumped, true, "n' = T*n_ts.x + B*n_ts.y + N*n_ts.z, rotated to world.");
                Vec3Row("World N (geometric)", h.normalGeom, true, "Normal of the shape itself, without bump.");
                Vec3Row("World T (dP/du)", h.tangent, false, "Tangent: direction of increasing u.");
                Vec3Row("World B (dP/dv)", h.bitangent, false, "Bitangent: direction of increasing v.");
                Vec3Row("World position", h.position, false, "Displaced surface point (magenta ring in 3D).");
            }
            ImGui::EndTable();
        }
        if (!h.onSurface)
            ImGui::TextDisabled("This uv is not on the %s's main UV chart.", ShapeName(shape_));
    }
    ImGui::EndGroup();
    ImGui::End();
}

@ \emph{The ``Viewport'' panel} has the one change in the user interface that has
nothing to do with Metal. ImGui on macOS measures the screen in \emph{points}, and a
Retina display has two pixels per point in each direction. If the scene were rendered
with one texel per point, ImGui would stretch it to twice its size and it would look
blurred. The scene is therefore rendered at the size in pixels, |DisplayFramebufferScale|
times the size in points, and shown at the size in points. (On Windows the back end works
in pixels, and the factor is~1.)

The camera matrices are built with the functions of \S\ref{macmath}, and their product is
written in the column-vector order: |proj * view| transforms a point first by |view|.

<<Functions of the application (macOS)>>=
void App::UiViewport() {
    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0, 0));
    ImGui::Begin("Viewport");
    ImGui::PopStyleVar();
    const ImVec2 size = ImGui::GetContentRegionAvail();
    // The offscreen image has one texel per physical pixel (two per point on a Retina display).
    const float scale = ImGui::GetIO().DisplayFramebufferScale.x;
    const uint32_t w = uint32_t(std::max(1.0f, size.x * scale)), h = uint32_t(std::max(1.0f, size.y * scale));

    const float3 eye = camera_.Eye();
    const float3 lp = light_.Position();
    const simd::float4x4 view = MatrixLookAtRH(eye, float3{0, 0, 0}, float3{0, 1, 0});
    const simd::float4x4 proj = MatrixPerspectiveFovRH(45 * kDegToRad, float(w) / float(h), 0.05f, 100.0f);

