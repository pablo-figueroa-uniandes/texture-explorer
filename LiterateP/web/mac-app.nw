@ The repository root is found as on Windows, by walking up from the executable, which on
macOS is inside an application bundle (\texttt{TextureExplorer.app/Contents/MacOS}). The
marker is the Metal shader. |_NSGetExecutablePath| is the macOS counterpart of
|GetModuleFileNameW|.

<<Private helpers of the application (macOS)>>=
// The repository root: the folder that holds assets/ and mac/shaders/.
std::filesystem::path FindRoot() {
    char buf[4096];
    uint32_t size = sizeof(buf);
    if (_NSGetExecutablePath(buf, &size) == 0)
        for (auto p = std::filesystem::path(buf).parent_path(); p.has_relative_path(); p = p.parent_path())
            if (std::filesystem::exists(p / "mac" / "shaders" / "pbr.metal")) return p;
    return std::filesystem::path(TEXEX_ROOT);
}

@ |ShellExecuteW| becomes Launch Services, a C interface of macOS that opens a URL with the
default application.

<<Private helpers of the application (macOS)>>=
void OpenUrl(const std::string& url) {
    CFURLRef ref = CFURLCreateWithBytes(nullptr, reinterpret_cast<const UInt8*>(url.data()), CFIndex(url.size()),
                                        kCFStringEncodingUTF8, nullptr);
    if (!ref) return;
    LSOpenCFURLRef(ref, nullptr);
    CFRelease(ref);
}

