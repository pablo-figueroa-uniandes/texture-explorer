@ A frame of the interface is the frame of the first part. On most Mac keyboards the
function keys need the \textsf{fn} key, so Command-R reloads the shaders as well. (On
macOS, the back end of ImGui reports the Command key as |ImGuiMod_Ctrl|, so that
shortcuts written for Windows mean the same thing on a Mac.)

<<Functions of the application (macOS)>>=
void App::Frame(float dt) {
    if (rotate_) rotAngle_ = std::fmod(rotAngle_ + rotSpeed_ * dt, 2 * kPi);
    if (light_.autoOrbit) light_.azimuth = std::fmod(light_.azimuth + light_.speed * dt, 2 * kPi);
    // F5 needs the fn key on most Mac keyboards; Cmd+R does the same (ImGuiMod_Ctrl is Cmd on macOS).
    if (ImGui::IsKeyPressed(ImGuiKey_F5) || ImGui::IsKeyChordPressed(ImGuiMod_Ctrl | ImGuiKey_R)) ReloadShaders();
    if (ImGui::IsKeyPressed(ImGuiKey_Space) && !ImGui::GetIO().WantTextInput) rotate_ = !rotate_;

    <<Create the dock space and its initial layout>>

    <<If there are no materials, say why and stop>>

    <<Build the panels and run the probe>>
}

