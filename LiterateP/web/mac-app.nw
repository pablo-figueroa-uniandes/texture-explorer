@ The arrows and the circles of the first part, with \texttt{simd} arithmetic. A
|float3| passed where a |LineVertex| wants a |Float3| is converted automatically.

<<Arrows and circles made of lines (macOS)>>=
void AddArrow(std::vector<LineVertex>& out, float3 from, float3 dir, float len, Float4 color) {
    const float3 to = from + simd::normalize(dir) * len;
    out.push_back({from, color});
    out.push_back({to, color});
    // Small arrow head: two short lines in a plane containing dir.
    float3 side = simd::cross(dir, float3{0, 1, 0});
    if (simd::length_squared(side) < 1e-6f) side = simd::cross(dir, float3{1, 0, 0});
    side = simd::normalize(side) * (len * 0.12f);
    const float3 back = to - simd::normalize(dir) * (len * 0.2f);
    out.push_back({to, color}); out.push_back({back + side, color});
    out.push_back({to, color}); out.push_back({back - side, color});
}

void AddCircle(std::vector<LineVertex>& out, float3 center, float3 ax, float3 ay, float r, Float4 color) {
    const int n = 24;
    for (int i = 0; i < n; ++i) {
        const float a0 = 2 * kPi * i / n, a1 = 2 * kPi * (i + 1) / n;
        out.push_back({center + r * (std::cos(a0) * ax + std::sin(a0) * ay), color});
        out.push_back({center + r * (std::cos(a1) * ax + std::sin(a1) * ay), color});
    }
}

@
<<Functions of the application (macOS)>>=
float3 OrbitCamera::Eye() const {
    return {distance * std::cos(pitch) * std::sin(yaw), distance * std::sin(pitch),
            distance * std::cos(pitch) * std::cos(yaw)};
}

float3 OrbitLight::Position() const {
    return {radius * std::cos(elevation) * std::sin(azimuth), radius * std::sin(elevation),
            radius * std::cos(elevation) * std::cos(azimuth)};
}

@ The materials are loaded through the renderer's device and queue, and the shaders come
from \texttt{mac/shaders}.

<<Functions of the application (macOS)>>=
bool App::Init() {
    if (!renderer_.Init()) return false;
    root_ = FindRoot();
    if (library_.Load(root_ / "assets" / "materials", loadError_))
        for (int i = 0; i < int(library_.Items().size()); ++i)  // all, for the thumbnails
            library_.EnsureLoaded(i, renderer_.Device(), renderer_.Queue());
    ReloadShaders();
    return true;
}

