@ The file is opened with a wide-character name, so that paths with accents work on
Windows. We always ask for four channels: a grey JPEG is then expanded to grey RGB,
which keeps all the code that follows uniform.

<<Decode the image file>>=
FILE* f = nullptr;
_wfopen_s(&f, path.c_str(), L"rb");
if (!f) return nullptr;
int w = 0, h = 0, n = 0;
stbi_uc* pixels = stbi_load_from_file(f, &w, &h, &n, 4);
fclose(f);
if (!pixels) return nullptr;

@
<<Keep a CPU copy of the pixels>>=
auto img = std::make_shared<MapImage>();
img->width = w;
img->height = h;
img->rgba.assign(pixels, pixels + size_t(w) * h * 4);
stbi_image_free(pixels);

@ The texture is created with a \emph{typeless} format. This is what allows two views
with different interpretations (\texttt{UNORM} and \texttt{UNORM\_SRGB}) of the same
bytes. Asking for |MipLevels = 0| means ``the whole chain'', and the flags
|RENDER_TARGET| and |GENERATE_MIPS| let the GPU compute the smaller levels itself.

<<Create a texture with a full mipmap chain>>=
// Typeless storage lets the same texture be viewed as linear (UI) or sRGB (shading).
D3D11_TEXTURE2D_DESC td{};
td.Width = w;
td.Height = h;
td.MipLevels = 0;  // full chain
td.ArraySize = 1;
td.Format = DXGI_FORMAT_R8G8B8A8_TYPELESS;
td.SampleDesc.Count = 1;
td.Usage = D3D11_USAGE_DEFAULT;
td.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
td.MiscFlags = D3D11_RESOURCE_MISC_GENERATE_MIPS;
if (FAILED(device->CreateTexture2D(&td, nullptr, &img->texture))) return nullptr;

@
<<Create the linear and sRGB views>>=
D3D11_SHADER_RESOURCE_VIEW_DESC sd{};
sd.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
sd.Texture2D.MipLevels = UINT(-1);
sd.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
device->CreateShaderResourceView(img->texture.Get(), &sd, &img->srvLinear);
if (srgb) {
    sd.Format = DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;
    device->CreateShaderResourceView(img->texture.Get(), &sd, &img->srvSrgb);
} else {
    img->srvSrgb = img->srvLinear;
}

@ \emph{Reading the manifest.} The manifest is an array of objects; missing fields get
harmless defaults. Any error is reported as text, which the user interface shows instead
of the viewport---typically because the download script has not been run yet.

<<Read the manifest>>=
bool MaterialLibrary::Load(const std::filesystem::path& materialsDir, std::string& error) {
    dir_ = materialsDir;
    std::ifstream in(materialsDir / "manifest.json");
    if (!in) {
        error = "Cannot open " + (materialsDir / "manifest.json").string() +
                "\nRun tools\\fetch_textures.ps1 first.";
        return false;
    }
    try {
        <<Parse the entries of the manifest>>
    } catch (const std::exception& ex) {
        error = std::string("manifest.json: ") + ex.what();
        return false;
    }
    if (items_.empty()) error = "manifest.json lists no materials";
    return !items_.empty();
}

@
<<Parse the entries of the manifest>>=
const nlohmann::json j = nlohmann::json::parse(in);
static const char* keys[MapCount] = {"color", "bump", "displacement", "roughness", "normal"};
for (const auto& e : j) {
    Material m;
    m.id = e.value("id", "");
    m.name = e.value("name", m.id);
    m.site = e.value("site", "");
    m.url = e.value("url", "");
    m.author = e.value("author", "");
    m.license = e.value("license", "");
    m.bumpFromHeight = e.value("bumpFromHeight", true);
    if (e.contains("files"))
        for (int k = 0; k < MapCount; ++k)
            m.files[k] = e["files"].value(keys[k], "");
    items_.push_back(std::move(m));
}

@ \label{bumpfromheight}\emph{Loading the maps of a material.} The paths in the manifest
are UTF-8; C++20 wants them as |char8_t| to interpret them so. Only the colour map is
given an sRGB view.

Then comes a decision that matters for teaching. Neither ambientCG nor Poly Haven ships a
separate bump map for these materials, and this is no accident: a bump map \emph{is} a
height field, and the displacement map is the height field of the material. So when no
bump map is present we use the displacement map in its place, and remember that we did,
so that the interface can say so. The same data then plays both roles, and switching
bump and displacement on and off separately shows clearly what each one does.

<<Load the maps of a material on first use>>=
void MaterialLibrary::EnsureLoaded(int index, ID3D11Device* device, ID3D11DeviceContext* ctx) {
    Material& m = items_[index];
    if (m.loaded) return;
    m.loaded = true;
    for (int k = 0; k < MapCount; ++k)
        if (!m.files[k].empty())
            m.maps[k] = LoadImage(dir_ / std::filesystem::path(reinterpret_cast<const char8_t*>(m.files[k].c_str())), k == MapColor, device, ctx);
    // A bump map is a height field used only for shading. When a pack has no separate
    // one, the height (displacement) map is the bump map.
    if (!m.maps[MapBump]) {
        m.maps[MapBump] = m.maps[MapDisplacement];
        m.bumpFromHeight = true;
    } else {
        m.bumpFromHeight = false;
    }
}

@ \label{fetch}\emph{Collecting the materials.} The ten example materials are not part
of the program; a PowerShell script downloads them and writes the manifest. Seven come
from ambientCG, whose web API returns, for a list of asset identifiers, the address of a
ZIP file for each resolution; three come from Poly Haven, whose API returns the address
of each map separately. All of them are in the public domain (CC0).

