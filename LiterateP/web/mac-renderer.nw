@ Shutting down releases the meshes; every other object is released by its |SharedPtr|.

<<Functions of the renderer (macOS)>>=
void Renderer::Shutdown() {
    for (GpuMesh& m : meshes_) m = GpuMesh{};
}

@ The command buffer of a frame comes from the queue. Like every object returned by a
function whose name does not start with |new|, it belongs to the \emph{autorelease pool}
that is active when it is created, which here is the pool that the main program opens
around each frame (<<The frame>>). The renderer keeps only a plain pointer to it.

<<Functions of the renderer (macOS)>>=
<<Start the command buffer of the frame>>

@
<<Start the command buffer of the frame>>=
MTL::CommandBuffer* Renderer::BeginFrame() {
    frame_ = queue_->commandBuffer();
    return frame_;
}

@ \emph{Compiling shaders at run time.} The Windows version compiles HLSL with
|D3DCompileFromFile|. Metal can compile source text too: |newLibrary| turns a string of
MSL into a \emph{library} of compiled functions. (The usual practice for a finished
product is to compile the shaders with the build into a \texttt{.metallib} file; compiling
at run time is what makes editing and reloading with F5 possible.) Messages of the
compiler, warnings as well as errors, are collected in |log|, which the user interface
shows.

<<Functions of the renderer (macOS)>>=
static NS::String* Str(const std::string& s) { return NS::String::string(s.c_str(), NS::UTF8StringEncoding); }

@
<<Functions of the renderer (macOS)>>=
static NS::SharedPtr<MTL::Library> Compile(MTL::Device* device, const std::filesystem::path& file,
                                           std::string& log) {
    std::ifstream in(file);
    if (!in) {
        log += "Cannot open " + file.string() + "\n";
        return {};
    }
    std::stringstream source;
    source << in.rdbuf();
    NS::Error* error = nullptr;
    MTL::CompileOptions* options = MTL::CompileOptions::alloc()->init();
    MTL::Library* lib = device->newLibrary(Str(source.str()), options, &error);
    options->release();
    if (error) log += file.filename().string() + ": " + error->localizedDescription()->utf8String() + "\n";
    return NS::TransferPtr(lib);
}

